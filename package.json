{
  "name": "flock-realtime-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first realtime collaboration. Peers that always converge.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/crdt",
    "packages/sync",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @flock/web",
    "build:pages": "tsc -b && npm run build:pages -w @flock/web && node scripts/check-pages-base.mjs apps/web/dist /flock-realtime-collab/",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsc -b && node apps/server/dist/main.js",
    "dev:web": "npm run dev -w @flock/web",
    "bench": "tsc -b && node bench/dist/run.js",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
